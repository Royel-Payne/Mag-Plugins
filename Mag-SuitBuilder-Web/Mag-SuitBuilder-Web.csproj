<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- WinExe: no console window on double-click; the app lives in the system tray instead -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Must contain no dots: SpellTools derives the embedded-resource root namespace from the
         first resource name's first dot-segment (see Shared\Spells\SpellTools.cs). -->
    <RootNamespace>MagSuitBuilderWeb</RootNamespace>
    <AssemblyName>Mag-SuitBuilder-Web</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Constants\*.cs" Link="Shared\Constants\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\ItemInfo.cs" Link="Shared\ItemInfo.cs" />
    <Compile Include="..\Shared\MyWorldObject.cs" Link="Shared\MyWorldObject.cs" />
    <Compile Include="..\Shared\ObjectClass.cs" Link="Shared\ObjectClass.cs" />
    <Compile Include="..\Shared\SerializableDictionary.cs" Link="Shared\SerializableDictionary.cs" />
    <Compile Include="..\Shared\Spells\Spell.cs" Link="Shared\Spells\Spell.cs" />
    <Compile Include="..\Shared\Spells\SpellTools.cs" Link="Shared\Spells\SpellTools.cs" />
    <Compile Include="..\Mag-SuitBuilder\Search\*.cs" Link="Search\%(Filename)%(Extension)" />
    <Compile Include="..\Mag-SuitBuilder\Equipment\ExtendedMyWorldObject.cs" Link="Equipment\ExtendedMyWorldObject.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- SpellTools derives its resource root from the FIRST dot-segment of the first manifest
         resource name; with a dot-free RootNamespace every resource below shares that segment,
         so adding more embedded resources here stays safe. -->
    <EmbeddedResource Include="..\Shared\Spells\Spells.csv" Link="Shared\Spells\Spells.csv" />
    <!-- The whole UI rides inside the assembly so a published single-file exe needs no wwwroot
         folder (served by Services\EmbeddedWwwroot at runtime). -->
    <EmbeddedResource Include="wwwroot\**\*" />
    <Content Update="wwwroot\**\*" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Single-exe publish polish -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
